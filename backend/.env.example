# Copy to .env and fill in real values. Never commit .env.
# All values below are fake placeholders.

# --- Server ---
# Port the API listens on (default 5050).
PORT=5050
# "production" on Render; enables secure cookies and Stripe live mode by default.
NODE_ENV=development
# Allowed frontend origin(s), comma-separated; also used for Stripe redirect URLs.
CLIENT_URL=http://localhost:5173
# Optional frontend URL for Stripe redirects (falls back to CLIENT_URL).
FRONTEND_URL=
# Number of proxies in front of the API (default 2 = Vercel rewrite + Render).
# Used to find the real client IP in X-Forwarded-For. Note: calls made straight
# to the onrender.com URL skip Vercel, so with 2 hops a caller can still fake
# their IP there. Per-portfolio limits must never depend on IP alone.
TRUST_PROXY_HOPS=2
# Set to true to log req.ip and req.ips per request (to confirm the hop count
# in production). Leave false normally: it logs client IPs.
LOG_CLIENT_IP=false
# Pino log level: trace, debug, info, warn, error, fatal or silent
# (default info; tests use silent).
LOG_LEVEL=info

# --- Database ---
# MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/westforce-dev

# --- Firebase Admin (use the JSON variable OR the three separate ones) ---
# Full service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase project id.
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service-account client email.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-firebase-project-id.iam.gserviceaccount.com
# Service-account private key, with \n for line breaks.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# --- Gemini ---
# Google Gemini API key.
GEMINI_API_KEY=your-gemini-api-key
# Model for the chatbot (default gemini-3.6-flash).
GEMINI_CHAT_MODEL=
# Model for resume generation/enhancement (default gemini-3.6-flash).
GEMINI_RESUME_MODEL=
# AI resume builds per user per UTC day (default 20). 0 turns the feature off.
RESUME_BUILD_DAILY_LIMIT=20
# AI resume enhancements per user per UTC day (default 30). 0 turns the feature off.
RESUME_ENHANCE_DAILY_LIMIT=30
# Max anonymous (signed-out) chat requests per UTC day across all users (default 500).
CHAT_ANON_DAILY_CAP=500
# Max anonymous chat requests per client IP per UTC day (default 50).
CHAT_ANON_DAILY_PER_IP=50

# --- Document protection ---
# Long random string used to hash document PINs and sign access cookies.
DOCUMENT_ACCESS_SECRET=change-me-to-a-long-random-string

# --- Portfolio insights ---
# Long random string used to hash visitors for daily view counts.
# Required in production: the server will not start without it.
INSIGHTS_HASH_SECRET=

# --- Stripe ---
# "demo" (needs sk_test_ key) or "live" (needs sk_live_ key).
STRIPE_MODE=demo
# Stripe secret key.
STRIPE_SECRET_KEY=sk_test_replace_me
# Stripe webhook signing secret.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Cloudinary (use CLOUDINARY_URL OR the three separate ones) ---
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Cloudinary cloud name.
CLOUDINARY_CLOUD_NAME=your-cloud-name
# Cloudinary API key.
CLOUDINARY_API_KEY=your-cloudinary-api-key
# Cloudinary API secret.
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- Supabase (video uploads) ---
# Supabase project URL.
SUPABASE_URL=https://your-project.supabase.co
# Supabase service/secret key (server only).
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Fallback key if the secret key is not set.
SUPABASE_ANON_KEY=
# Storage bucket for videos (default westforce-videos).
SUPABASE_VIDEO_BUCKET=westforce-videos

# --- Daily job collector (npm run jobs:collect, optional) ---
# Jooble API key. Without it only the public Greenhouse and Lever boards are read.
JOOBLE_API_KEY=

# --- Email (Resend) ---
# "live" sends real mail; anything else (or unset) only logs the subject and
# recipient count. Tests never send. Keep it unset for local work.
MAIL_MODE=
# Resend API key. Live mode needs it.
RESEND_API_KEY=
# Sender on a domain verified in Resend. Live mode needs it.
MAIL_FROM="WestForce <hello@example.com>"
# Testing only. Optional comma list. When set, only these addresses get any
# email from the site, including password reset (others are skipped and
# counted in the logs). Leave it empty for real users.
MAIL_ALLOWLIST=
# Public site address for email links and the logo (default: first CLIENT_URL).
# Its domain must be in Firebase Authentication > Settings > Authorized domains.
SITE_URL=http://localhost:5173

# --- Admin ---
# Owners: comma list of verified login emails with full admin access at /admin.
# Owners add and remove other admins in the portal and can't be removed there.
# Empty means no owners (admins added earlier in the portal still work).
ADMIN_EMAILS=owner@example.com
