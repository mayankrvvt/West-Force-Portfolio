{
  "name": "westforce-server",
  "private": true,
  "version": "1.0.0",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "migrate:resume-owner": "tsx scripts/migrate-resume-owner.ts",
    "jobs:collect": "tsx src/scripts/collectJobs.ts",
    "jobs:digest": "tsx src/scripts/sendJobDigest.ts",
    "mail:preview": "tsx src/scripts/mailPreview.ts"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.3",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "resend": "^6.39.0",
    "stripe": "^23.0.0",
    "typescript": "~6.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
