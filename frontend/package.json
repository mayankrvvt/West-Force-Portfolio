{
  "name": "westforce-frontend",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix ../backend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "npm run dev --prefix ../backend",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm start --prefix ../backend"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.42.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "vite": "^7.1.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  }
}